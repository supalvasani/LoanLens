APP_ENV=development
DB_URL=postgresql+asyncpg://postgres:admin@127.0.0.1:5432/loanlens_db
JWT_SECRET=change-me-in-production-use-long-random-string
REFRESH_TOKEN_SECRET=change-me-refresh-secret-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8
REFRESH_TOKEN_EXPIRY_DAYS=7
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=DEBUG
LOG_BACKUP_COUNT=72

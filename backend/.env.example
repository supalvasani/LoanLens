# LoanLens backend — environment configuration
# Copy this file to .env and fill in values before starting the server.
# Do NOT commit .env — it is in .gitignore.

APP_ENV=development
DB_URL=postgresql+asyncpg://postgres:admin@127.0.0.1:5433/loanlens_db

JWT_SECRET=change-me-in-production-use-long-random-string
REFRESH_TOKEN_SECRET=change-me-refresh-secret-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8
REFRESH_TOKEN_EXPIRY_DAYS=7

CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=DEBUG
LOG_BACKUP_COUNT=72

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── LLM / Chatbot ─────────────────────────────────────────────────────────────
#
# Option A — Local Ollama (no API key required)
#   1. Install Ollama: https://ollama.com/download
#   2. Pull a tool-calling model:
#        ollama pull llama3.1          # recommended — 8B, supports tool calling
#        ollama pull qwen2.5:7b        # strong alternative
#        ollama pull mistral-nemo      # lighter option
#   3. Set the values below:
#
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=                             # leave blank for local Ollama
# LLM_MODEL=llama3.1
#
# Option B — Docker Compose Ollama (docker-compose.yml optional profile)
#   Uncomment the `ollama` service in docker-compose.yml, then:
#
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
#
# Option C — OpenAI or compatible hosted API
#
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
#
# Option D — CI / tests without a real model (returns a stub response)
#
# LLM_MOCK=true
#
# Defaults — LLM is disabled; backend returns HTTP 503 on chatbot requests
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=60
LLM_MOCK=false
